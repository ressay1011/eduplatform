# === Servidor ===
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# === Base de datos (rol app_user — SUJETO a RLS, ADR-002) ===
DATABASE_URL=postgresql://app_user:app_user_dev@localhost:5432/eduplatform

# === Auth propia (sesiones) — pepper para hashear tokens; mínimo 16 caracteres ===
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_PEPPER=cambiar-por-pepper-de-32-hex-en-produccion

# === Rate limiting (por IP, ventana de 60s) ===
# Global de la API y límite estricto de los endpoints de login.
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=10

# === Datos abiertos del MEN (opcional) ===
# App token de datos.gov.co (Socrata), para la consulta por código DANE del
# onboarding. Sin token la petición sale del pool compartido por IP; con token
# el cupo propio es de 1.000 peticiones por hora. Se registra en el perfil de
# datos.gov.co → «Configuración de desarrollo» → «Crear nuevo token de aplicación».
# Dejar vacío o comentado es válido.
# DATOS_GOV_APP_TOKEN=

# === Cookie de sesión ===
# lax  = web y API en el mismo dominio registrable (app./api.eduplatform.co) — recomendado
# none = Vercel + Render en dominios distintos (exige HTTPS; abre la puerta a CSRF,
#        por eso el informe S5 recomienda dominio propio)
COOKIE_SAMESITE=lax