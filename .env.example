# =============================================================================
# Variables de entorno — copiar a .env y ajustar.
# NUNCA commitear valores reales de producción.
# =============================================================================

# --- Base de datos local (docker compose) ---
# Rol de MIGRACIONES (dueño del esquema; usado por drizzle-kit)
DATABASE_URL_MIGRATOR=postgresql://app_migrator:app_migrator_dev@localhost:5432/eduplatform
# Rol de RUNTIME (sujeto a RLS; lo usa la API)
DATABASE_URL_APP=postgresql://app_user:app_user_dev@localhost:5432/eduplatform

# --- API (apps/api) ---
# (se completará al crear la API)
# JWT_SECRET=
# TOKEN_PEPPER=
# PORT=4000
# CORS_ORIGINS=http://localhost:3000