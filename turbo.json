{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "NEXT_PUBLIC_API_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "DATABASE_URL",
        "MIGRATOR_URL",
        "TOKEN_PEPPER",
        "CORS_ORIGINS",
        "COOKIE_SAMESITE",
        "THROTTLE_LIMIT",
        "THROTTLE_LOGIN_LIMIT"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "DATABASE_URL",
        "MIGRATOR_URL",
        "TOKEN_PEPPER",
        "CORS_ORIGINS",
        "COOKIE_SAMESITE",
        "THROTTLE_LIMIT",
        "THROTTLE_LOGIN_LIMIT"
      ]
    }
  }
}
