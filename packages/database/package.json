{
  "name": "@eduplatform/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:rls": "node --env-file-if-exists=.env scripts/apply-rls.mjs",
    "db:neon": "node --env-file-if-exists=.env scripts/neon-bootstrap.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "db:verify": "node --env-file-if-exists=.env scripts/verify-rls.mjs",
    "db:audit": "node --env-file-if-exists=.env scripts/audit-seguridad.mjs",
    "test:coverage": "vitest run --coverage",
    "db:colegio": "node --env-file-if-exists=.env scripts/crear-colegio.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@eduplatform/types": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
