# =============================================================================
# Base de datos — paquete @eduplatform/database
# Copiar a `packages/database/.env`. Los scripts lo cargan con
# `--env-file-if-exists=.env`; drizzle-kit lo lee por su cuenta.
# =============================================================================

# Rol de MIGRACIONES: dueño del esquema, crea tablas, políticas de RLS y el
# catálogo de permisos. Lo usan drizzle-kit y los scripts que ESCRIBEN
# (db:push, db:rls, db:colegio, db:seed).
DATABASE_URL=postgresql://app_migrator:***@localhost:5432/eduplatform

# Ojo: db:verify y db:audit comprueban el aislamiento CONECTANDO COMO app_user
# (el dueño del esquema no está sujeto a RLS y todo les «fallaría»). Pásales la
# URL de runtime por delante, que la variable del shell gana sobre este archivo:
#   DATABASE_URL='postgresql://app_user:...@localhost:5432/eduplatform' \
#     TENANT_ID=<uuid del colegio> pnpm db:verify

# --- Sembrado del colegio demo (`pnpm db:seed`) — todo opcional ---
# DEMO_CODIGO=demo-dist-1
# DEMO_COLEGIO=I.E.T.D. Juana Arias de Benavides
# DEMO_ADMIN=admin@demo-dist-1
# Hash bcrypt de la clave del admin demo. Sin él el colegio se crea pero sin
# usuario para entrar: genéralo con
#   node -e "require('bcrypt').hash('tu-clave',10).then(console.log)"
# DEMO_HASH=

# --- Verificación de RLS (`pnpm db:verify`) ---
# El colegio va por terminal, que cambia en cada base:
#   TENANT_ID=<uuid del colegio> pnpm db:verify
