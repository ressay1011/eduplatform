{
  "name": "@eduplatform/types",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "//": "Doble build: CommonJS para la API (moduleResolution node10) y ESM para la web, que es la única que puede sacudir el paquete. Sin el ESM, importar un valor del barril mete zod entero en el navegador (~478 KB).",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
